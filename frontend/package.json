{
  "name": "template-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "pm2 start build.config.cjs --env production",
    "stop": "pm2 stop build.config.cjs --env production",
    "rebuild": "pnpm build && pnpm stop && pnpm start",
    "postinstall": "nuxt prepare",
    "proto:gen": "make -C .. proto-generate-ts",
    "proto:lint": "make -C .. proto-lint",
    "mock": "tsx watch mock/server.ts",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@pinia/nuxt": "^0.11.2",
    "@primevue/forms": "^4.3.7",
    "@primevue/themes": "^4.3.7",
    "@tailwindcss/vite": "^4.1.11",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.6.0",
    "@vueuse/nuxt": "^13.6.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.539.0",
    "nuxt": "^4.1.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "4.3.7",
    "tailwindcss": "^4.1.11",
    "tailwindcss-primeui": "^0.6.1",
    "uuid": "^11.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.57.0",
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@connectrpc/connect-node": "^2.1.0",
    "@nuxt/eslint": "^1.8.0",
    "@primevue/nuxt-module": "^4.3.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.0"
  }
}
